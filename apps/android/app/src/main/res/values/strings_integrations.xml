    <!-- Importar y sincronizar, Teams en tableros y administración (F8-08). -->
    <string name="imports_title">Importar y sincronizar</string>
    <string name="imports_file_title">Desde un archivo exportado</string>
    <string name="imports_file_intro">En Google Calendar, abre Configuración → Importar y exportar → Exportar. Descargarás un .zip con un .ics por calendario. También vale un .ics suelto (hasta 25 MB).</string>
    <string name="imports_file_pick">Elegir el archivo</string>
    <string name="imports_file_too_large">El fichero supera los 25 MB</string>
    <string name="imports_account_title">Desde tu cuenta de Google</string>
    <string name="imports_account_intro">Delyra lee tus calendarios, colores, eventos y recordatorios una sola vez, con permiso de solo lectura. No guarda ningún acceso permanente a tu cuenta.</string>
    <string name="imports_account_web">La conexión con Google se hace en delyra.app, que se abre en el navegador (inicia sesión allí si te lo pide). Al volver, la importación aparece en «Importaciones recientes».</string>
    <string name="imports_connect_web">Conectar con Google en delyra.app</string>
    <string name="imports_google_unavailable">La conexión directa con Google aún no está disponible. Usa la exportación en archivo.</string>
    <string name="imports_no_browser">No hay ningún navegador para abrir delyra.app.</string>
    <string name="imports_updated">actualizado %1$s</string>
    <string name="sync_title">Sincronizar con Google</string>
    <string name="sync_intro">Mantiene al día, cada 15 minutos, los calendarios de Google que elijas. En Delyra son de solo lectura: se editan en Google.</string>
    <string name="sync_permanent_note">Para sincronizar, Delyra guarda (cifrado) un permiso permanente de solo lectura. Puedes desconectar cuando quieras y se revoca en Google.</string>
    <string name="sync_web_note">La conexión se hace en delyra.app, que se abre en el navegador. Al volver, elige aquí qué calendarios sincronizar.</string>
