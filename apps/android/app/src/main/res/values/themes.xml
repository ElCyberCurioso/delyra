<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#007145</color>
    <color name="canvas">#FAF9F4</color>
    <color name="canvas_dark">#070E0A</color>

    <style name="Theme.Delyra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <style name="Theme.Delyra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="postSplashScreenTheme">@style/Theme.Delyra</item>
    </style>
</resources>
