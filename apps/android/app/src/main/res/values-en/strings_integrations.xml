    <string name="imports_title">Import and sync</string>
    <string name="imports_file_title">From an exported file</string>
    <string name="imports_file_intro">In Google Calendar, open Settings → Import &amp; export → Export. You\'ll download a .zip with one .ics per calendar. A single .ics works too (up to 25 MB).</string>
    <string name="imports_file_pick">Choose the file</string>
    <string name="imports_file_too_large">The file is larger than 25 MB</string>
    <string name="imports_account_title">From your Google account</string>
    <string name="imports_account_intro">Delyra reads your calendars, colours, events and reminders once, with read-only permission. It doesn\'t keep any permanent access to your account.</string>
    <string name="imports_account_web">Connecting with Google happens on delyra.app, which opens in the browser (sign in there if asked). When you come back, the import shows up in “Recent imports”.</string>
    <string name="imports_connect_web">Connect with Google on delyra.app</string>
    <string name="imports_google_unavailable">The direct connection with Google isn\'t available yet. Use the file export.</string>
    <string name="imports_no_browser">There\'s no browser to open delyra.app.</string>
    <string name="imports_updated">updated %1$s</string>
    <string name="sync_title">Sync with Google</string>
    <string name="sync_intro">Keeps the Google calendars you choose up to date every 15 minutes. In Delyra they\'re read-only: edit them in Google.</string>
    <string name="sync_permanent_note">To sync, Delyra stores (encrypted) a permanent read-only permission. You can disconnect whenever you like and it\'s revoked in Google.</string>
    <string name="sync_web_note">Connecting happens on delyra.app, which opens in the browser. When you come back, choose here which calendars to sync.</string>
