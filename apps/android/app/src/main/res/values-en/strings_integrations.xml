    <string name="teams_title">Teams meetings</string>
    <string name="teams_intro">The meetings in your Microsoft 365 calendar show up as cards on their own, with their date and the join link. They\'re updated every 15 minutes.</string>
    <string name="teams_unavailable">Teams meetings aren\'t available yet: Microsoft 365 isn\'t set up on the server.</string>
    <string name="teams_connect">Connect Microsoft 365 on the web</string>
    <string name="teams_reconnect">Connect again on the web</string>
    <string name="teams_web_note">Connecting happens on work.delyra.app, which opens in the browser: on the board, Settings → Teams meetings. When you come back, choose here where to add them.</string>
    <string name="teams_permission">Delyra only reads your calendar (subject, time, location, organiser and Teams link), never the content of the meetings.</string>
    <string name="teams_connected_as">Connected as %1$s.</string>
