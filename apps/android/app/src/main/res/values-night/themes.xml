<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Delyra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_dark</item>
    </style>

    <style name="Theme.Delyra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="postSplashScreenTheme">@style/Theme.Delyra</item>
    </style>
</resources>
