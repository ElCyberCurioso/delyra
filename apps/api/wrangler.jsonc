{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Worker `api` (Hono). Solo es accesible por Service Binding desde los dos frontends:
  // sin workers.dev, sin preview URLs y sin rutas propias.
  "name": "delyra-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },

  // ── Desarrollo local (entorno por defecto) ─────────────────────────────────────
  "vars": {
    "APP_ENV": "development",
    "CF_ACCOUNT_ID": "",
    "D1_DATABASE_ID": "",
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delyra-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "delyra-backups-local" },
    { "binding": "ATTACHMENTS", "bucket_name": "delyra-attachments-local" },
    { "binding": "IMPORTS", "bucket_name": "delyra-imports-local" },
  ],
  "queues": {
    "producers": [{ "binding": "NOTIFICATIONS", "queue": "delyra-notifications-local" }],
    "consumers": [
      {
        "queue": "delyra-notifications-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "delyra-notifications-dlq-local",
      },
    ],
  },
  "workflows": [
    {
      "name": "delyra-system-backup-local",
      "binding": "SYSTEM_BACKUP",
      "class_name": "SystemBackupWorkflow",
    },
  ],

  "env": {
    // ── Staging ───────────────────────────────────────────────────────────────────
    "staging": {
      "name": "delyra-api-staging",
      "vars": {
        "APP_ENV": "staging",
        // Se rellenan tras crear los recursos (docs/runbooks/recursos-cloudflare.md).
        "CF_ACCOUNT_ID": "",
        "D1_DATABASE_ID": "",
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "delyra-staging",
          "database_id": "00000000-0000-4000-8000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "delyra-backups-staging", "jurisdiction": "eu" },
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "delyra-attachments-staging",
          "jurisdiction": "eu",
        },
        { "binding": "IMPORTS", "bucket_name": "delyra-imports-staging", "jurisdiction": "eu" },
      ],
      "queues": {
        "producers": [{ "binding": "NOTIFICATIONS", "queue": "delyra-notifications-staging" }],
        "consumers": [
          {
            "queue": "delyra-notifications-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "delyra-notifications-dlq-staging",
          },
        ],
      },
      "workflows": [
        {
          "name": "delyra-system-backup-staging",
          "binding": "SYSTEM_BACKUP",
          "class_name": "SystemBackupWorkflow",
          // 02:30 UTC todos los días.
          "schedules": ["30 2 * * *"],
        },
      ],
    },

    // ── Producción ────────────────────────────────────────────────────────────────
    "production": {
      "name": "delyra-api",
      "vars": {
        "APP_ENV": "production",
        "CF_ACCOUNT_ID": "",
        "D1_DATABASE_ID": "",
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "delyra-prod",
          "database_id": "00000000-0000-4000-8000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "delyra-backups", "jurisdiction": "eu" },
        { "binding": "ATTACHMENTS", "bucket_name": "delyra-attachments", "jurisdiction": "eu" },
        { "binding": "IMPORTS", "bucket_name": "delyra-imports", "jurisdiction": "eu" },
      ],
      "queues": {
        "producers": [{ "binding": "NOTIFICATIONS", "queue": "delyra-notifications" }],
        "consumers": [
          {
            "queue": "delyra-notifications",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "delyra-notifications-dlq",
          },
        ],
      },
      "workflows": [
        {
          "name": "delyra-system-backup",
          "binding": "SYSTEM_BACKUP",
          "class_name": "SystemBackupWorkflow",
          "schedules": ["0 2 * * *"],
        },
      ],
    },
  },
}
