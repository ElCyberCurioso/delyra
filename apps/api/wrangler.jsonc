{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker `api` (Hono). Solo es accesible por Service Binding desde los dos frontends:
  // sin workers.dev, sin preview URLs y sin rutas propias.
  //
  // Dos entornos (ADR-0003): el de nivel superior es el desarrollo local y `production` el único
  // remoto. El nombre local termina en `-local` para que un `wrangler deploy` sin `--env
  // production` nunca sobrescriba el Worker de producción.
  "name": "delyra-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },

  // ── Desarrollo local (entorno por defecto) ─────────────────────────────────────
  "vars": {
    "APP_ENV": "development",
    "CF_ACCOUNT_ID": "",
    "D1_DATABASE_ID": "",
    // Clave de prueba de Turnstile que siempre pasa (documentación de Cloudflare).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // En local la cookie es del host (localhost sirve a las dos SPA en distintos puertos).
    "SESSION_COOKIE_DOMAIN": "",
    "MAIL_FROM": "no-reply@delyra.app",
    "PWNED_PASSWORDS_CHECK": "off",
    // Sin bot en local: la vinculación aparece como no disponible (los tests simulan Telegram).
    "TELEGRAM_BOT_USERNAME": "",
  },
  // F3-05: alertas y resumen diario, cada minuto. F4-07: autoarchivado, a las 03:00 UTC.
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // F1-10: límite general de la API y otro más estricto para /api/auth/*.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delyra-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "delyra-backups-local" },
    { "binding": "ATTACHMENTS", "bucket_name": "delyra-attachments-local" },
    { "binding": "IMPORTS", "bucket_name": "delyra-imports-local" },
  ],
  "queues": {
    "producers": [{ "binding": "NOTIFICATIONS", "queue": "delyra-notifications-local" }],
    "consumers": [
      {
        "queue": "delyra-notifications-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "delyra-notifications-dlq-local",
      },
    ],
  },
  "workflows": [
    {
      "name": "delyra-system-backup-local",
      "binding": "SYSTEM_BACKUP",
      "class_name": "SystemBackupWorkflow",
    },
    // F5-02: importaciones de Google Calendar (.ics, .zip y API) por lotes.
    {
      "name": "delyra-import-local",
      "binding": "IMPORT_WORKFLOW",
      "class_name": "ImportWorkflow",
    },
  ],

  "env": {
    // ── Producción ────────────────────────────────────────────────────────────────
    "production": {
      "name": "delyra-api",
      "vars": {
        "APP_ENV": "production",
        // No son secretos; los usa el backup diario (docs/runbooks/recursos-cloudflare.md).
        "CF_ACCOUNT_ID": "b87bc1a8f7e74107a115865b54ddc455",
        "D1_DATABASE_ID": "f1a9ef7a-8b4f-4f0b-859d-734c1d68b84c",
        // Site key del widget de Turnstile de producción (P-08). No es secreta.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGL8dLU9DrKaDU9f",
        "SESSION_COOKIE_DOMAIN": "delyra.app",
        "MAIL_FROM": "no-reply@delyra.app",
        "PWNED_PASSWORDS_CHECK": "on",
        // Nombre del bot de @BotFather sin @ (P-10). Vacío = Telegram desactivado.
        "TELEGRAM_BOT_USERNAME": "delyra_app_bot",
      },
      "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      // Email (F1-12): añadir cuando delyra.app esté dado de alta en Email Service (P-07):
      // "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@delyra.app"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "delyra-prod",
          "database_id": "f1a9ef7a-8b4f-4f0b-859d-734c1d68b84c",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "delyra-backups", "jurisdiction": "eu" },
        { "binding": "ATTACHMENTS", "bucket_name": "delyra-attachments", "jurisdiction": "eu" },
        { "binding": "IMPORTS", "bucket_name": "delyra-imports", "jurisdiction": "eu" },
      ],
      "queues": {
        "producers": [{ "binding": "NOTIFICATIONS", "queue": "delyra-notifications" }],
        "consumers": [
          {
            "queue": "delyra-notifications",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "delyra-notifications-dlq",
          },
        ],
      },
      "workflows": [
        {
          "name": "delyra-system-backup",
          "binding": "SYSTEM_BACKUP",
          "class_name": "SystemBackupWorkflow",
          // 02:00 UTC todos los días.
          "schedules": ["0 2 * * *"],
        },
        {
          "name": "delyra-import",
          "binding": "IMPORT_WORKFLOW",
          "class_name": "ImportWorkflow",
        },
      ],
    },
  },
}
