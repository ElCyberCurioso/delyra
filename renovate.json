{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Europe/Madrid",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencias"],
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Cloudflare (wrangler, plugins, workerd) en un solo PR: deben ir alineados",
      "matchPackageNames": ["wrangler", "workerd", "miniflare", "@cloudflare/**"],
      "groupName": "cloudflare"
    },
    {
      "description": "Vitest y sus paquetes van con la misma versión",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "vitest"
    },
    {
      "description": "typescript-eslint aún no admite TypeScript >= 6.1 (ADR-0001)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "Parches y menores de herramientas de desarrollo agrupados",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "herramientas de desarrollo"
    }
  ]
}
